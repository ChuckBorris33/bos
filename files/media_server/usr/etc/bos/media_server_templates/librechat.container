[Unit]
Description=LibreChat
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/danny-avila/librechat:latest
AutoUpdate=registry
ContainerName=librechat

# Expose web UI on localhost only, Caddy will reverse proxy
PublishPort=127.0.0.1:3080:3080

# Volumes for persistent data
Volume=/var/opt/librechat/uploads:/app/client/public/uploads:z
Volume=/var/opt/librechat/config:/app/config:Z

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target
